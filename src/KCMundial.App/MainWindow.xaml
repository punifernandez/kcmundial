<Window x:Class="KCMundial.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KCMundial.App"
        mc:Ignorable="d"
        Title="KCMundial" WindowState="Maximized" WindowStyle="None"
        ResizeMode="NoResize" Topmost="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" Background="{StaticResource BgPrimaryBrush}"/>
        <!-- Botón Cerrar visible en todas las pantallas (solo ícono, sin texto) -->
        <Button x:Name="BtnClose" Command="{Binding CloseAppCommand}" Style="{StaticResource IconButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"/>
        <!-- Overlay de confirmación de salida (estilo app, no Windows) -->
        <Border Background="#CC0f0f14" Visibility="{Binding ShowCloseConfirmOverlay, Converter={StaticResource BoolToVisibility}}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="32" MinWidth="280">
                <StackPanel>
                    <TextBlock Text="¿Cerrar la aplicación?" Style="{StaticResource TitleMedium}" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="No" Command="{Binding ConfirmCloseNoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="28,12"/>
                        <Button Content="Sí, cerrar" Command="{Binding ConfirmCloseYesCommand}" Style="{StaticResource DangerButton}" Padding="28,12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

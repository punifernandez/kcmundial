<Window x:Class="KCMundial.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KCMundial 2" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource NavyDeepBrush}" FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True">
    <Grid>
        <!-- Transición suave entre pantallas -->
        <ContentControl Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Confirmación de salida -->
        <Grid Background="{StaticResource ScrimBrush}" Visibility="{Binding ShowCloseConfirmOverlay, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource GlassCard}" Background="{StaticResource NavyBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="48,40" MinWidth="520">
                <StackPanel>
                    <TextBlock Text="¿Cerrar la aplicación?" Style="{StaticResource TitleLarge}" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="El photobooth deja de funcionar hasta que la vuelvas a abrir." Style="{StaticResource Caption}" FontSize="18"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,32"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="NO, SEGUIR" Command="{Binding ConfirmCloseNoCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0"/>
                        <Button Content="SÍ, CERRAR" Command="{Binding ConfirmCloseYesCommand}" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

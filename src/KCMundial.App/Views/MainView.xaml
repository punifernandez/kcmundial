<UserControl x:Class="KCMundial.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignHeight="1920" d:DesignWidth="1080">
    <UserControl.Resources>
        <!-- Marco a elegir: tarjeta con número grande; la elegida con borde dorado y un poco más grande -->
        <Style x:Key="FrameChoice" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ring" Width="150" Height="210" CornerRadius="6" BorderThickness="5"
                                BorderBrush="{DynamicResource FrameIdleBorderBrush}" Background="{DynamicResource SurfaceSolidBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale"/>
                            </Border.RenderTransform>
                            <Border CornerRadius="2" ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource FrameSelectedBorderBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Número del marco, estilo dorsal -->
        <Style x:Key="FrameNumber" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderPanelBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Style="{StaticResource HeaderPanel}" Margin="48,40,48,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.Eyebrow}" Style="{StaticResource Eyebrow}" FontSize="24"/>
                    <TextBlock Text="{DynamicResource Text.MainTitle}" Style="{StaticResource Display}" FontSize="58" Margin="0,-4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="★★★" Foreground="{DynamicResource GoldBrush}" FontSize="34" VerticalAlignment="Center" Margin="0,0,20,0"
                           Visibility="{DynamicResource StarsVisibility}"/>
                <Button Grid.Column="2" Style="{StaticResource SquareIconButton}" Command="{Binding ToggleAdminPanelCommand}" VerticalAlignment="Center" ToolTip="Operador">
                    <Path Data="{StaticResource IconCog}" Style="{StaticResource Icon}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Preview en vivo con el marco (misma proporción que la foto final) -->
        <Border Grid.Row="1" Margin="64,28,64,16" HorizontalAlignment="Center" BorderBrush="{DynamicResource PhotoMatBrush}" BorderThickness="6" CornerRadius="6"
                Background="{DynamicResource PreviewBackdropBrush}">
            <Viewbox Stretch="Uniform">
                <Grid Width="{Binding PreviewBoxWidth}" Height="{Binding PreviewBoxHeight}" ClipToBounds="True" Background="{DynamicResource PreviewBackdropBrush}">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PreviewMirrorScale}"/>
                        </Grid.RenderTransform>
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="Linear">
                            <Image.LayoutTransform>
                                <RotateTransform Angle="{Binding PreviewRotation}"/>
                            </Image.LayoutTransform>
                        </Image>
                    </Grid>
                    <Image Source="{Binding PreviewFrameOverlay}" Stretch="Fill" IsHitTestVisible="False"/>

                    <!-- Esperando la cámara -->
                    <Grid Background="{DynamicResource PreviewBackdropBrush}"
                          Visibility="{Binding IsCameraReady, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60"
                                    Visibility="{Binding CameraError, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <Control Style="{StaticResource Spinner}" Width="90" Height="90"/>
                            <TextBlock Text="Conectando la cámara…" Style="{StaticResource TitleLarge}" FontSize="44" HorizontalAlignment="Center" Margin="0,28,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Indicación de posición -->
                    <Border Style="{StaticResource Chip}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,190"
                            Visibility="{Binding GuidanceMessage, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="{Binding GuidanceMessage}" Style="{StaticResource TitleLarge}" FontSize="44" Foreground="{DynamicResource ChipTextBrush}"/>
                    </Border>

                    <!-- Cuenta regresiva: marcador -->
                    <Grid Background="#40000000" Visibility="{Binding IsCountdownVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border Width="400" Height="400" Background="{DynamicResource CountdownPanelBrush}" BorderBrush="{DynamicResource CountdownBorderBrush}"
                                BorderThickness="10" CornerRadius="{DynamicResource CountdownCornerRadius}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountdownNumber, NotifyOnTargetUpdated=True}" Style="{StaticResource Display}" FontSize="300"
                                       Foreground="{DynamicResource CountdownTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-30,0,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1.5" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1.5" To="1" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Chip}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,110">
                            <TextBlock Text="{DynamicResource Text.CountdownHint}" Style="{StaticResource Display}" FontSize="56" Foreground="{DynamicResource ChipTextBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Armando la foto -->
                    <Grid Background="{DynamicResource ScrimBrush}" Visibility="{Binding IsProcessingVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Control Style="{StaticResource Spinner}" Width="120" Height="120"/>
                            <TextBlock Text="{DynamicResource Text.Processing}" Style="{StaticResource Display}" FontSize="84" Margin="0,40,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Text.ProcessingSub}" Style="{StaticResource Caption}" FontSize="36" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Destello del disparo -->
                    <Rectangle x:Name="FlashRect" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Error -->
        <Border Grid.Row="1" Style="{StaticResource Chip}" Background="{DynamicResource DangerBrush}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,44,0,0"
                Visibility="{Binding CameraError, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconAlert}" Fill="White" Width="26" Height="26" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding CameraError}" Style="{StaticResource Body}" Foreground="White" FontSize="20" VerticalAlignment="Center" MaxWidth="700"/>
            </StackPanel>
        </Border>

        <!-- Elegí tu marco / camiseta -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
            <TextBlock Text="{DynamicResource Text.FrameLabel}" Style="{StaticResource Eyebrow}" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource FrameChoice}" Command="{Binding SelectFrameCommand}" CommandParameter="1" Tag="{Binding IsFrame1Selected}">
                    <Grid>
                        <Image Source="{Binding FrameThumbnail1}" Stretch="UniformToFill"/>
                        <Border Style="{StaticResource FrameNumber}"><TextBlock Text="1" Style="{StaticResource Display}" FontSize="40" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/></Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource FrameChoice}" Command="{Binding SelectFrameCommand}" CommandParameter="2" Tag="{Binding IsFrame2Selected}">
                    <Grid>
                        <Image Source="{Binding FrameThumbnail2}" Stretch="UniformToFill"/>
                        <Border Style="{StaticResource FrameNumber}"><TextBlock Text="2" Style="{StaticResource Display}" FontSize="40" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/></Border>
                    </Grid>
                </Button>
                <Button Style="{StaticResource FrameChoice}" Command="{Binding SelectFrameCommand}" CommandParameter="3" Tag="{Binding IsFrame3Selected}">
                    <Grid>
                        <Image Source="{Binding FrameThumbnail3}" Stretch="UniformToFill"/>
                        <Border Style="{StaticResource FrameNumber}"><TextBlock Text="3" Style="{StaticResource Display}" FontSize="40" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/></Border>
                    </Grid>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Disparador: bloque de ancho completo -->
        <Grid Grid.Row="3" Margin="64,36,64,56" Height="130">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" BorderThickness="4"
                    Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource ShutterIcon}" Fill="{DynamicResource PrimaryButtonTextBrush}" Width="56" Height="56" Stretch="Uniform" Margin="0,0,20,0"/>
                    <TextBlock Text="{DynamicResource Text.Shutter}" FontSize="48" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Panel del operador -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsAdminPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#99000000">
                <Rectangle.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleAdminPanelCommand}"/>
                </Rectangle.InputBindings>
            </Rectangle>
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceSolidBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,130,48,0" Width="460" Padding="28">
                <StackPanel>
                    <TextBlock Text="OPERADOR" Style="{StaticResource Eyebrow}"/>

                    <TextBlock Text="Cámara" Style="{StaticResource Caption}" Margin="0,18,0,8"/>
                    <ComboBox x:Name="CameraComboBox" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera, Mode=OneWay}"
                              DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBox}" DropDownClosed="CameraComboBox_DropDownClosed"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                        <Run Text="Activa:"/> <Run Text="{Binding ActiveCameraDisplayName, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Text="Tema" Style="{StaticResource Caption}" Margin="0,22,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Command="{Binding SetThemeCommand}" CommandParameter="mundialista" Margin="0,0,6,0" MinHeight="56" FontSize="22">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeMundialista}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Mundialista
                        </Button>
                        <Button Command="{Binding SetThemeCommand}" CommandParameter="plano" Margin="6,0,0,0" MinHeight="56" FontSize="22">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemePlano}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            Plano
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="Impresoras" Style="{StaticResource Caption}" Margin="0,22,0,8"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ConfigureSmallPrinterCommand}" MinHeight="56" FontSize="22">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPrinter}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Configurar impresora figurita" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ConfigureXlPrinterCommand}" Margin="0,10,0,0" MinHeight="56" FontSize="22">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPrinter}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Configurar impresora XL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AdminMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding AdminMessage, Converter={StaticResource NullToVisibility}}"/>

                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenGalleryCommand}" Margin="0,22,0,0" MinHeight="56" FontSize="22">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGallery}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Galería" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding CloseAppCommand}" Margin="0,10,0,0" MinHeight="56" FontSize="22">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Cerrar la app" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

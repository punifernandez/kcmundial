<UserControl x:Class="KCMundial.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Style="{StaticResource HeaderPanel}" Margin="48,40,48,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Text.ResultEyebrow}" Style="{StaticResource Eyebrow}" FontSize="26"/>
                    <TextBlock Text="{DynamicResource Text.ResultTitle}" Style="{StaticResource Display}" FontSize="58" Margin="0,-4,0,0"/>
                </StackPanel>
                <TextBlock Text="★★★" Foreground="{DynamicResource GoldBrush}" FontSize="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{DynamicResource StarsVisibility}"/>
            </Grid>
        </Border>

        <!-- Figurita, entra como pegada en el álbum -->
        <Border Grid.Row="1" Margin="100,28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                Background="{DynamicResource PhotoMatBrush}" Padding="10" CornerRadius="4">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PopScale" ScaleX="0.6" ScaleY="0.6"/>
                    <RotateTransform x:Name="PopRotate" Angle="-8"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PopScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopRotate" Storyboard.TargetProperty="Angle" To="-2" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Image Source="{Binding FiguritaImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- QR + estado de las impresiones -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="64,8,64,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="220" Height="220" Background="White" CornerRadius="6" Padding="8">
                    <Grid>
                        <Image Source="{Binding QrImage}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Control Style="{StaticResource Spinner}" Foreground="#0A1B3D"
                                 Visibility="{Binding QrImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Escaneá y llevate tu foto" Style="{StaticResource TitleLarge}" FontSize="40"/>
                    <TextBlock FontSize="20" Margin="0,2,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Text" Value="Apuntá la cámara del celular al código"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QrImage}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Generando tu código…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentControl Content="{Binding Small}" ContentTemplate="{StaticResource PrintStatusTemplate}" Focusable="False"/>
                    <ContentControl Content="{Binding Xl}" ContentTemplate="{StaticResource PrintStatusTemplate}" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Acciones: sin tiempo, la pantalla espera a que el invitado elija -->
        <StackPanel Grid.Row="3" Margin="64,24,64,56">
            <UniformGrid Columns="2">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding Small.PrintCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPrinter}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                        <TextBlock Text="IMPRIMIR OTRA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButton}" Command="{Binding Xl.PrintCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource XlIcon}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                        <TextBlock Text="IMPRIMIR XL" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackCommand}" Margin="0,16,0,0" MinHeight="110" BorderThickness="4">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCamera}" Fill="{DynamicResource PrimaryButtonTextBrush}" Width="44" Height="44" Stretch="Uniform" Margin="0,0,18,0"/>
                    <TextBlock Text="TOMAR OTRA FOTO" FontSize="42" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="KCMundial.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="1920" d:DesignWidth="1080">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,40,40,8">
            <TextBlock Text="UNIDOS X UNA PASIÓN" Style="{StaticResource Eyebrow}" FontSize="24"/>
            <TextBlock Text="¡Tu figurita está lista!" Style="{StaticResource Display}" FontSize="64"/>
        </StackPanel>

        <!-- Figurita con entrada animada -->
        <Border Grid.Row="1" Margin="80,20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                Background="White" Padding="10" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="12" Opacity="0.5"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PopScale" ScaleX="0.6" ScaleY="0.6"/>
                    <RotateTransform x:Name="PopRotate" Angle="-6"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PopScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="PopRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Image Source="{Binding FiguritaImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- QR + estado de las impresiones -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="60,12,60,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="230" Height="230" Background="White" CornerRadius="20" Padding="8">
                    <Grid>
                        <Image Source="{Binding QrImage}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Control Style="{StaticResource Spinner}" Foreground="{StaticResource NavyBrush}"
                                 Visibility="{Binding QrImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Escaneá y llevate tu foto" Style="{StaticResource TitleLarge}" FontSize="40"/>
                    <TextBlock FontSize="20" Margin="0,4,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Text" Value="Apuntá la cámara del celular al código"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QrImage}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Generando tu código…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentControl Content="{Binding Small}" ContentTemplate="{StaticResource PrintStatusTemplate}" Focusable="False"/>
                    <ContentControl Content="{Binding Xl}" ContentTemplate="{StaticResource PrintStatusTemplate}" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Acciones: sin tiempo, la pantalla espera a que el invitado elija -->
        <Grid Grid.Row="3" Margin="60,28,60,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Command="{Binding Small.PrintCommand}" Padding="18,16">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPrinter}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                    <TextBlock Text="IMPRIMIR OTRA" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding Xl.PrintCommand}" Padding="18,16"
                    BorderBrush="{StaticResource GoldBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPrinter}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                    <TextBlock Text="IMPRIMIR XL" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding BackCommand}" Padding="18,16">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCamera}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                    <TextBlock Text="TOMAR OTRA FOTO" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>

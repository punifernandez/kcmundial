<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Paleta: noche azul + celeste bandera + dorado "sol de mayo"
         ============================================================ -->
    <Color x:Key="NavyDeep">#06132A</Color>
    <Color x:Key="Navy">#0B2350</Color>
    <Color x:Key="NavyLight">#153A78</Color>
    <Color x:Key="Celeste">#74ACDF</Color>
    <Color x:Key="CelesteLight">#B7DAF7</Color>
    <Color x:Key="Gold">#F6B40E</Color>
    <Color x:Key="GoldLight">#FFD45C</Color>
    <Color x:Key="GoldDark">#C98800</Color>
    <Color x:Key="Danger">#FF5A6A</Color>
    <Color x:Key="Success">#3DDC97</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#B8C8E2</Color>

    <SolidColorBrush x:Key="NavyDeepBrush" Color="{StaticResource NavyDeep}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}"/>
    <SolidColorBrush x:Key="CelesteBrush" Color="{StaticResource Celeste}"/>
    <SolidColorBrush x:Key="CelesteLightBrush" Color="{StaticResource CelesteLight}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="GlassBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#CC06132A"/>

    <!-- Fondo de todas las pantallas -->
    <RadialGradientBrush x:Key="AppBackgroundBrush" Center="0.5,0.08" GradientOrigin="0.5,0.08" RadiusX="1.1" RadiusY="0.75">
        <GradientStop Color="#1F4E93" Offset="0"/>
        <GradientStop Color="{StaticResource Navy}" Offset="0.45"/>
        <GradientStop Color="{StaticResource NavyDeep}" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GoldLight}" Offset="0"/>
        <GradientStop Color="{StaticResource Gold}" Offset="0.55"/>
        <GradientStop Color="{StaticResource GoldDark}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CelesteGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Celeste}" Offset="0"/>
        <GradientStop Color="{StaticResource CelesteLight}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Celeste}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================ Tipografía -->
    <FontFamily x:Key="DisplayFont">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI Black</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="64"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{StaticResource CelesteBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="34"/>
    </Style>
    <Style x:Key="TitleMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="26"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Tema mundialista: cancha, marcador de estadio, camiseta celeste y blanca, tres estrellas. -->

    <!-- Césped cortado en franjas -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,240" SpreadMethod="Repeat">
        <GradientStop Color="#0F5A32" Offset="0"/>
        <GradientStop Color="#0F5A32" Offset="0.5"/>
        <GradientStop Color="#0B4E2A" Offset="0.5"/>
        <GradientStop Color="#0B4E2A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Camiseta: bastones celestes y blancos -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="120,0" SpreadMethod="Repeat">
        <GradientStop Color="#74ACDF" Offset="0"/>
        <GradientStop Color="#74ACDF" Offset="0.5"/>
        <GradientStop Color="#FFFFFF" Offset="0.5"/>
        <GradientStop Color="#FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#0A1B3D"/>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="#0A1B3D"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="AccentButtonBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#F6B40E"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFE8D6"/>
    <SolidColorBrush x:Key="EyebrowBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5A6A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#66FFFFFF"/>

    <!-- Marcador: negro con borde dorado -->
    <SolidColorBrush x:Key="HeaderPanelBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#F6B40E"/>
    <Thickness x:Key="HeaderBorderThickness">3</Thickness>
    <Thickness x:Key="HeaderPadding">24,14</Thickness>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#CC0B0F14"/>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="StatusRowBrush" Color="#8C0B0F14"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#E60B0F14"/>
    <SolidColorBrush x:Key="ChipTextBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#D90B2A17"/>
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="PhotoMatBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FrameIdleBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="FrameSelectedBorderBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="CountdownPanelBrush" Color="#0B0F14"/>
    <SolidColorBrush x:Key="CountdownBorderBrush" Color="#F6B40E"/>
    <SolidColorBrush x:Key="CountdownTextBrush" Color="#F6B40E"/>
    <CornerRadius x:Key="CountdownCornerRadius">24</CornerRadius>

    <!-- Detalles -->
    <Visibility x:Key="StarsVisibility">Visible</Visibility>
    <Geometry x:Key="ShutterIcon">M16.93,17.12L16.13,15.76L17.59,11.39L19,10.92L20,11.67C20,11.7 20,11.72 20,11.75C20,13.74 19.26,15.55 18.05,16.95L16.93,17.12M9.92,14L8.53,9.89L12,7.47L15.47,9.89L14.08,14H9.92M12,20C11.12,20 10.28,19.86 9.5,19.59L8.93,18.16L9.63,17H14.38L15.07,18.17L14.5,19.59C13.73,19.86 12.88,20 12,20M5.95,16.95C4.74,15.55 4,13.74 4,11.75C4,11.72 4,11.7 4,11.67L5,10.92L6.41,11.39L7.87,15.76L7.07,17.12L5.95,16.95M11,5.29V6.69L7,9.46L5.66,9L5.24,7.69C6.29,6.07 7.93,4.84 9.86,4.29L11,5.29M14.14,4.29C16.07,4.84 17.71,6.07 18.76,7.69L18.34,9L17,9.46L13,6.69V5.29L14.14,4.29M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</Geometry>
    <Geometry x:Key="XlIcon">M18 2C17.1 2 16 3 16 4H8C8 3 6.9 2 6 2H2V11C2 12 3 13 4 13H6.2C6.6 15 7.9 16.7 11 17V19.08C8 19.54 8 22 8 22H16C16 22 16 19.54 13 19.08V17C16.1 16.7 17.4 15 17.8 13H20C21 13 22 12 22 11V2H18M6 11H4V4H6V11M20 11H18V4H20V11Z</Geometry>

    <!-- Textos -->
    <sys:String x:Key="Text.Eyebrow">UNIDOS X UNA PASIÓN</sys:String>
    <sys:String x:Key="Text.MainTitle">¡Sacate tu figurita!</sys:String>
    <sys:String x:Key="Text.FrameLabel">ELEGÍ TU CAMISETA</sys:String>
    <sys:String x:Key="Text.Shutter">¡PATEÁ! SACAR FOTO</sys:String>
    <sys:String x:Key="Text.CountdownHint">¡MIRÁ A LA CÁMARA!</sys:String>
    <sys:String x:Key="Text.Processing">¡Qué golazo!</sys:String>
    <sys:String x:Key="Text.ProcessingSub">Estamos armando tu figurita</sys:String>
    <sys:String x:Key="Text.ResultEyebrow">¡GOOOL!</sys:String>
    <sys:String x:Key="Text.ResultTitle">Tu figurita está lista</sys:String>
    <sys:String x:Key="Text.SecondScreenTitle">¡Llevate tu figurita!</sys:String>

    <!-- Líneas de la cancha detrás de todo -->
    <ControlTemplate x:Key="BackgroundDecoration" TargetType="Control">
        <Grid IsHitTestVisible="False" Opacity="0.28">
            <Rectangle Height="4" Fill="White" VerticalAlignment="Center"/>
            <Ellipse Width="560" Height="560" Stroke="White" StrokeThickness="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Ellipse Width="18" Height="18" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Border Width="620" Height="260" BorderBrush="White" BorderThickness="4,0,4,4" VerticalAlignment="Top" HorizontalAlignment="Center"/>
            <Border Width="620" Height="260" BorderBrush="White" BorderThickness="4,4,4,0" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <Border BorderBrush="White" BorderThickness="4" Margin="24"/>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>

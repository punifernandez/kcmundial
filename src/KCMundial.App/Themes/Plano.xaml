<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Tema de la app: azul noche sólido, líneas finas, acento celeste. Lo usan los estilos de AppTheme.xaml. -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A1B3D"/>

    <!-- Botón principal: degradé celeste -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A9D4F5" Offset="0"/>
        <GradientStop Color="#74ACDF" Offset="0.55"/>
        <GradientStop Color="#4A8FD4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#0A1B3D"/>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#8CC0EC"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#2F5596"/>

    <SolidColorBrush x:Key="AccentButtonBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="AccentButtonTextBrush" Color="#74ACDF"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#74ACDF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9FB8DA"/>
    <SolidColorBrush x:Key="EyebrowBrush" Color="#8FB8E8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#74ACDF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5A6A"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1E3663"/>

    <!-- Encabezado: sin caja, solo una línea abajo -->
    <SolidColorBrush x:Key="HeaderPanelBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#1E3663"/>
    <Thickness x:Key="HeaderBorderThickness">0,0,0,2</Thickness>
    <Thickness x:Key="HeaderPadding">4,8,4,20</Thickness>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E2350"/>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#0E2350"/>
    <SolidColorBrush x:Key="StatusRowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#F20A1B3D"/>
    <SolidColorBrush x:Key="ChipTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#E60A1B3D"/>
    <SolidColorBrush x:Key="PreviewBackdropBrush" Color="#06132A"/>
    <SolidColorBrush x:Key="PhotoMatBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FrameIdleBorderBrush" Color="#2F5596"/>
    <SolidColorBrush x:Key="FrameSelectedBorderBrush" Color="#74ACDF"/>
    <SolidColorBrush x:Key="CountdownPanelBrush" Color="#CC0A1B3D"/>
    <SolidColorBrush x:Key="CountdownBorderBrush" Color="#74ACDF"/>
    <SolidColorBrush x:Key="CountdownTextBrush" Color="#A9D4F5"/>
    <CornerRadius x:Key="CountdownCornerRadius">8</CornerRadius>

    <Visibility x:Key="StarsVisibility">Collapsed</Visibility>
    <Geometry x:Key="ShutterIcon">M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z</Geometry>
    <Geometry x:Key="XlIcon">M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91Z</Geometry>

    <sys:String x:Key="Text.Eyebrow">UNIDOS X UNA PASIÓN</sys:String>
    <sys:String x:Key="Text.MainTitle">Hacé tu figurita</sys:String>
    <sys:String x:Key="Text.FrameLabel">ELEGÍ TU MARCO</sys:String>
    <sys:String x:Key="Text.Shutter">SACAR LA FOTO</sys:String>
    <sys:String x:Key="Text.CountdownHint">MIRÁ A LA CÁMARA</sys:String>
    <sys:String x:Key="Text.Processing">¡Qué buena foto!</sys:String>
    <sys:String x:Key="Text.ProcessingSub">Estamos armando tu figurita</sys:String>
    <sys:String x:Key="Text.ResultEyebrow">LISTO</sys:String>
    <sys:String x:Key="Text.ResultTitle">Tu figurita está lista</sys:String>
    <sys:String x:Key="Text.SecondScreenTitle">Llevate tu figurita</sys:String>

    <ControlTemplate x:Key="BackgroundDecoration" TargetType="Control">
        <Grid/>
    </ControlTemplate>
</ResourceDictionary>

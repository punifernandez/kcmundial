<Window x:Class="KCMundial.App.SecondaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KCMundial.App.ViewModels"
        Title="KCMundial 2 - Monitor 2" WindowStyle="None" ResizeMode="NoResize" ShowActivated="False"
        Background="Black" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Aparece con fundido cuando cambia a ese modo -->
        <Style x:Key="ModePanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <!-- Espera: video en loop -->
        <Grid Background="Black">
            <MediaElement x:Name="IdleVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Volume="0" IsMuted="True"/>
        </Grid>

        <!-- Resultado: figurita + QR -->
        <Grid Background="{StaticResource AppBackgroundBrush}">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource ModePanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:SecondaryDisplayMode.Result}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" Margin="40">
                <Grid Width="1920" Height="1080">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" Padding="12" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Height="980">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="14" Opacity="0.55"/>
                        </Border.Effect>
                        <Image Source="{Binding FiguritaImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="UNIDOS X UNA PASIÓN" Style="{StaticResource Eyebrow}" FontSize="40"/>
                        <TextBlock Text="¡Llevate tu foto!" Style="{StaticResource Display}" FontSize="120"/>
                        <Border Width="440" Height="440" Background="White" CornerRadius="32" Padding="16" Margin="0,40,0,28">
                            <Grid>
                                <Image Source="{Binding QrImage}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Control Style="{StaticResource Spinner}" Width="110" Height="110" Foreground="{StaticResource NavyBrush}"
                                         Visibility="{Binding QrImage, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Escaneá el código con tu celular" Style="{StaticResource TitleMedium}" FontSize="44" HorizontalAlignment="Center"
                                   Foreground="{StaticResource CelesteLightBrush}"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Galería: foto grande -->
        <Grid Background="{StaticResource AppBackgroundBrush}">
            <Grid.Style>
                <Style TargetType="Grid" BasedOn="{StaticResource ModePanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:SecondaryDisplayMode.GalleryPhoto}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="White" Padding="12" CornerRadius="20" Margin="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding FiguritaImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>
    </Grid>
</Window>

<Application x:Class="KCMundial.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KCMundial.App.ViewModels"
             xmlns:views="clr-namespace:KCMundial.App.Views"
             xmlns:conv="clr-namespace:KCMundial.App.Converters"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <!-- Estado de una impresión (figurita o XL): ícono + texto. Oculto hasta que se imprime algo. -->
            <DataTemplate x:Key="PrintStatusTemplate" DataType="{x:Type vm:PrintJobViewModel}">
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Padding="18,10" Margin="0,6,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Control Style="{StaticResource Spinner}" Width="26" Height="26" Foreground="{StaticResource GoldBrush}" Margin="0,0,12,0"
                                 Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVisibility}}"/>
                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,12,0"
                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"/>
                        <Path Data="{StaticResource IconAlert}" Fill="{StaticResource DangerBrush}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,12,0"
                              Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="20" VerticalAlignment="Center" MaxWidth="520">
                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <views:MainView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultViewModel}">
                <views:ResultView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GalleryViewModel}">
                <views:GalleryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GalleryDetailViewModel}">
                <views:GalleryDetailView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
